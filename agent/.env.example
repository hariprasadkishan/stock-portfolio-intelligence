# ===============================================================================
# DATABASE CONFIGURATION
# ===============================================================================
# Full PostgreSQL connection URL (SQLAlchemy + psycopg 3 format)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/stock_portfolio_intelligence

# Optional individual connection parameters (used if DATABASE_URL is not provided)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=your_user
# PGDATABASE=stock_portfolio_intelligence

# ===============================================================================
# AI & LLM PROVIDER CONFIGURATION
# ===============================================================================
# Active LLM provider: 'openai' or 'groq'
AI_PROVIDER=openai

# OpenAI Configuration (required if AI_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Groq Configuration (required if AI_PROVIDER=groq)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ===============================================================================
# SERVER CONFIGURATION
# ===============================================================================
PORT=8000
